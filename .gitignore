# Снимки DevTools: содержат живые токены, куки и перс. данные (NFR-5/SEC-001)
docs/*-recording.json
docs/calendar
docs/*.har

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
# Аудиторский сайдкар взаимодействий агентов (bd, audit.enabled) — локальная
# телеметрия прогона, не состояние трекера: оно живёт в Dolt и уезжает через
# refs/dolt/data (sync.remote в .beads/config.yaml), а не через этот файл.
.beads/interactions.jsonl
*.gate.lock*
packaging/*/dist/
